# Normalise every text file to LF in the repository.
* text=auto eol=lf

# Windows script hosts require CRLF; PowerShell does not, so it stays LF above.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary fixtures are stored byte for byte.
*.png binary

# NuGet lock files stay visible in review: a dependency change must be read.
packages.lock.json linguist-generated=false
