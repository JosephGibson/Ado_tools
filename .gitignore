# Never track local credentials or service configuration.
.env
.env.*
!.env.example
secrets/
secret/
*.pem
*.pfx
*.p12
*.key
id_rsa*
id_ed25519*
.npmrc
.pypirc
.netrc

# Local run output and stray tool logs.
*.log

# Build output and editor state.
bin/
obj/
target/
dist/
build/
artifacts/
coverage/
TestResults/
.cache/
.vs/
*.user
