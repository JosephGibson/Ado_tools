<?xml version="1.0" encoding="utf-8"?>
<!-- Restore uses nuget.org only. Clearing inherited sources keeps machine and user feeds, and
     their credential prompts, out of the build; the mapping satisfies central package management. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
