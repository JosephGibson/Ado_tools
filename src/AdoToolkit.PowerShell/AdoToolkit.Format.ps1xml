<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>AdoToolkit.Core.TestManagement.AdoTestCase</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.TestManagement.AdoTestCase</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Id</Label></TableColumnHeader>
        <TableColumnHeader><Label>Title</Label></TableColumnHeader>
        <TableColumnHeader><Label>StepCount</Label></TableColumnHeader>
        <TableColumnHeader><Label>Status</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Title</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>StepCount</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.TestManagement.AdoTestStep</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.TestManagement.AdoTestStep</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Number</Label></TableColumnHeader>
        <TableColumnHeader><Label>Kind</Label></TableColumnHeader>
        <TableColumnHeader><Label>Action</Label></TableColumnHeader>
        <TableColumnHeader><Label>ExpectedResult</Label></TableColumnHeader>
        <TableColumnHeader><Label>SharedStep</Label></TableColumnHeader>
        <TableColumnHeader><Label>DiagnosticCode</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>Number</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Kind</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Action</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>ExpectedResult</PropertyName></TableColumnItem>
        <TableColumnItem><ScriptBlock>$_.SharedStep.Title</ScriptBlock></TableColumnItem>
        <TableColumnItem><PropertyName>DiagnosticCode</PropertyName></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.TestManagement.AdoTestPlan</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.TestManagement.AdoTestPlan</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Id</Label></TableColumnHeader>
        <TableColumnHeader><Label>Name</Label></TableColumnHeader>
        <TableColumnHeader><Label>RootSuiteId</Label></TableColumnHeader>
        <TableColumnHeader><Label>TeamProject</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>RootSuiteId</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>TeamProject</PropertyName></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.TestManagement.AdoTestSuite</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.TestManagement.AdoTestSuite</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Id</Label></TableColumnHeader>
        <TableColumnHeader><Label>PlanId</Label></TableColumnHeader>
        <TableColumnHeader><Label>ParentSuiteId</Label></TableColumnHeader>
        <TableColumnHeader><Label>SuitePath</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>PlanId</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>ParentSuiteId</PropertyName></TableColumnItem>
        <TableColumnItem><ScriptBlock>$_.SuitePath -join ' > '</ScriptBlock></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.WorkItems.AdoWiqlResult</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.WorkItems.AdoWiqlResult</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Count</Label></TableColumnHeader>
        <TableColumnHeader><Label>LimitApplied</Label></TableColumnHeader>
        <TableColumnHeader><Label>AsOf</Label></TableColumnHeader>
        <TableColumnHeader><Label>TeamProject</Label></TableColumnHeader>
        <TableColumnHeader><Label>Columns</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><ScriptBlock>$_.Ids.Count</ScriptBlock></TableColumnItem>
        <TableColumnItem><PropertyName>LimitApplied</PropertyName></TableColumnItem>
        <TableColumnItem><ScriptBlock>$_.AsOf.ToLocalTime()</ScriptBlock></TableColumnItem>
        <TableColumnItem><PropertyName>TeamProject</PropertyName></TableColumnItem>
        <TableColumnItem><ScriptBlock>$_.Columns -join ', '</ScriptBlock></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.WorkItems.AdoWorkItem</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.WorkItems.AdoWorkItem</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
          <TableColumnHeader><Label>WorkItemType</Label></TableColumnHeader>
          <TableColumnHeader><Label>Title</Label></TableColumnHeader>
          <TableColumnHeader><Label>State</Label></TableColumnHeader>
          <TableColumnHeader><Label>TeamProject</Label></TableColumnHeader>
          <TableColumnHeader><Label>ChangedDate</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>WorkItemType</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Title</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>TeamProject</PropertyName></TableColumnItem>
          <TableColumnItem><ScriptBlock>$_.ChangedDate.ToLocalTime()</ScriptBlock></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.Connections.AdoConnection</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.Connections.AdoConnection</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>CollectionUri</Label></TableColumnHeader>
          <TableColumnHeader><Label>DefaultProject</Label></TableColumnHeader>
          <TableColumnHeader><Label>Authentication</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>CollectionUri</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>DefaultProject</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Authentication</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.Configuration.AdoProfile</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.Configuration.AdoProfile</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>CollectionUri</Label></TableColumnHeader>
          <TableColumnHeader><Label>DefaultProject</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>CollectionUri</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>DefaultProject</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.Connections.AdoProject</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.Connections.AdoProject</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
          <TableColumnHeader><Label>State</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.Connections.AdoConnectionTestResult</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.Connections.AdoConnectionTestResult</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Success</Label></TableColumnHeader>
          <TableColumnHeader><Label>Elapsed</Label></TableColumnHeader>
          <TableColumnHeader><Label>ApiVersion</Label></TableColumnHeader>
          <TableColumnHeader><Label>Hint</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Success</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Elapsed</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ApiVersion</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Hint</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.Builds.AdoBuildDefinition</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.Builds.AdoBuildDefinition</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Id</Label></TableColumnHeader>
        <TableColumnHeader><Label>Name</Label></TableColumnHeader>
        <TableColumnHeader><Label>Path</Label></TableColumnHeader>
        <TableColumnHeader><Label>TeamProject</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>TeamProject</PropertyName></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.Builds.AdoBuild</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.Builds.AdoBuild</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Id</Label></TableColumnHeader>
        <TableColumnHeader><Label>BuildNumber</Label></TableColumnHeader>
        <TableColumnHeader><Label>SourceBranch</Label></TableColumnHeader>
        <TableColumnHeader><Label>Status</Label></TableColumnHeader>
        <TableColumnHeader><Label>Result</Label></TableColumnHeader>
        <TableColumnHeader><Label>FinishTime</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>BuildNumber</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>SourceBranch</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Result</PropertyName></TableColumnItem>
        <TableColumnItem><ScriptBlock>if ($null -ne $_.FinishTime) { $_.FinishTime.ToLocalTime() }</ScriptBlock></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.Builds.AdoTimelineRecord</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.Builds.AdoTimelineRecord</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Name</Label></TableColumnHeader>
        <TableColumnHeader><Label>Type</Label></TableColumnHeader>
        <TableColumnHeader><Label>Result</Label></TableColumnHeader>
        <TableColumnHeader><Label>Attempt</Label></TableColumnHeader>
        <TableColumnHeader><Label>LogId</Label></TableColumnHeader>
        <TableColumnHeader><Label>StartTime</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Type</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Result</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Attempt</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>LogId</PropertyName></TableColumnItem>
        <TableColumnItem><ScriptBlock>if ($null -ne $_.StartTime) { $_.StartTime.ToLocalTime() }</ScriptBlock></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.Builds.AdoBuildFailure</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.Builds.AdoBuildFailure</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>BuildId</Label></TableColumnHeader>
        <TableColumnHeader><Label>Path</Label></TableColumnHeader>
        <TableColumnHeader><Label>Result</Label></TableColumnHeader>
        <TableColumnHeader><Label>Attempt</Label></TableColumnHeader>
        <TableColumnHeader><Label>LogId</Label></TableColumnHeader>
        <TableColumnHeader><Label>LogLineCount</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>BuildId</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Result</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Attempt</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>LogId</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>LogLineCount</PropertyName></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.TestRuns.AdoTestRun</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.TestRuns.AdoTestRun</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Id</Label></TableColumnHeader>
        <TableColumnHeader><Label>Name</Label></TableColumnHeader>
        <TableColumnHeader><Label>State</Label></TableColumnHeader>
        <TableColumnHeader><Label>TotalTests</Label></TableColumnHeader>
        <TableColumnHeader><Label>StartedDate</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>TotalTests</PropertyName></TableColumnItem>
        <TableColumnItem><ScriptBlock>if ($null -ne $_.StartedDate) { $_.StartedDate.ToLocalTime() }</ScriptBlock></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.TestRuns.AdoBuildTestFailureSet</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.TestRuns.AdoBuildTestFailureSet</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>BuildId</Label></TableColumnHeader>
        <TableColumnHeader><Label>BuildNumber</Label></TableColumnHeader>
        <TableColumnHeader><Label>FailedCount</Label></TableColumnHeader>
        <TableColumnHeader><Label>FlakyCount</Label></TableColumnHeader>
        <TableColumnHeader><Label>Runs</Label></TableColumnHeader>
        <TableColumnHeader><Label>Status</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><ScriptBlock>$_.Build.Id</ScriptBlock></TableColumnItem>
        <TableColumnItem><ScriptBlock>$_.Build.BuildNumber</ScriptBlock></TableColumnItem>
        <TableColumnItem><PropertyName>FailedCount</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>FlakyCount</PropertyName></TableColumnItem>
        <TableColumnItem><ScriptBlock>$_.Runs.Count</ScriptBlock></TableColumnItem>
        <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.TestRuns.AdoTestFailure</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.TestRuns.AdoTestFailure</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Ordinal</Label></TableColumnHeader>
        <TableColumnHeader><Label>Classification</Label></TableColumnHeader>
        <TableColumnHeader><Label>ShortName</Label></TableColumnHeader>
        <TableColumnHeader><Label>Attempts</Label></TableColumnHeader>
        <TableColumnHeader><Label>HasOpenBug</Label></TableColumnHeader>
        <TableColumnHeader><Label>Storage</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>Ordinal</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Classification</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>ShortName</PropertyName></TableColumnItem>
        <TableColumnItem><ScriptBlock>$_.Attempts.Count</ScriptBlock></TableColumnItem>
        <TableColumnItem><PropertyName>HasOpenBug</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Storage</PropertyName></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
    <View>
      <Name>AdoToolkit.Core.TestRuns.AdoTestBug</Name>
      <ViewSelectedBy><TypeName>AdoToolkit.Core.TestRuns.AdoTestBug</TypeName></ViewSelectedBy>
      <TableControl><TableHeaders>
        <TableColumnHeader><Label>Id</Label></TableColumnHeader>
        <TableColumnHeader><Label>IsOpen</Label></TableColumnHeader>
        <TableColumnHeader><Label>State</Label></TableColumnHeader>
        <TableColumnHeader><Label>WorkItemType</Label></TableColumnHeader>
        <TableColumnHeader><Label>Title</Label></TableColumnHeader>
      </TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
        <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>IsOpen</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>WorkItemType</PropertyName></TableColumnItem>
        <TableColumnItem><PropertyName>Title</PropertyName></TableColumnItem>
      </TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
